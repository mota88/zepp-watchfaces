{
  "configVersion": "v3",
  "app": {
    "appId": 25661,
    "appName": "Meridian",
    "appType": "watchface",
    "version": {
      "code": 15,
      "name": "9.0.0"
    },
    "vender": "Edu",
    "description": "City skyline that follows the time of day and the weather, with a compass bezel, seconds, steps and HybridCharge rings, heart rate, sun times, recovery, sleep and battery.",
    "icon": "icon.png"
  },
  "permissions": [
    "data:user.hd.step",
    "data:user.hd.heart_rate",
    "data:user.hd.sleep",
    "data:user.hd.workout",
    "device:os.compass",
    "device:os.barometer"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "2.0.0",
      "target": "2.0.0",
      "minVersion": "2.0.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 466
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Meridian"
    },
    "es-ES": {
      "appName": "Meridian"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
